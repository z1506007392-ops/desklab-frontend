{
  "name": "desklab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop": "tauri dev",
    "desktop:build": "node tools/sync-desktop-csp.mjs && tauri build",
    "tauri": "tauri",
    "dev:api": "node tools/dev-api-server.mjs",
    "eval:ai": "node tools/ai-eval/run-eval.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test",
    "test:ui": "playwright test --project=desktop --project=mobile",
    "test:ui:webkit": "playwright test --project=webkit-iphone e2e/scene-render.spec.mjs e2e/no-webgl.spec.mjs e2e/library-browse.spec.mjs e2e/local-save.spec.mjs e2e/templates.spec.mjs e2e/gizmo.spec.mjs e2e/compact-toolbar.spec.mjs e2e/error-notice.spec.mjs e2e/start-guide.spec.mjs e2e/selection-hint.spec.mjs e2e/offline-fonts.spec.mjs e2e/share-link.spec.mjs e2e/room-size.spec.mjs e2e/community-gallery.spec.mjs e2e/dialog-focus.spec.mjs",
    "test:ui:firefox": "playwright test --project=firefox",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
